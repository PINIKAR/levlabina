    <script>
        // שימור הלוגיקה המקורית של הטופס שלך
        document.getElementById('combinedForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const submitBtn = document.getElementById('submitBtn');
            const statusText = document.getElementById('formStatus');
            const myPhone = "972548383451"; 
            const name = document.getElementById('userName').value;
            const contact = document.getElementById('userContact').value;
            const message = document.getElementById('userMessage').value;
            
            submitBtn.disabled = true;
            statusText.classList.remove('hidden');

            fetch("https://formsubmit.co/ajax/pninakar@gmail.com", {
                method: "POST",
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ name: name, contact: contact, message: message, _subject: "ליד חדש בנושא סוכני AI" })
            })
            .then(() => {
                const text = `היי פנינה, הגעתי מהדף של סוכני ה-AI!%0Aשם: ${name}%0Aפרטי קשר: ${contact}%0Aהודעה: ${message}`;
                window.open(`https://wa.me/${myPhone}?text=${text}`, '_blank');
                document.getElementById('combinedForm').reset();
                submitBtn.disabled = false;
                statusText.innerText = "ההודעה נשלחה בהצלחה!";
            })
            .catch(() => {
                window.open(`https://wa.me/${myPhone}?text=ליד נכשל במייל: ${name}, ${contact}`, '_blank');
                submitBtn.disabled = false;
            });
        });
    </script>
