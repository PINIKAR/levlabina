    <section id="contact" class="py-20 px-6 bg-[#F8F5F1]">
        <div class="container mx-auto max-w-4xl text-right">
            <div class="bg-white rounded-3xl overflow-hidden shadow-2xl flex flex-col md:flex-row-reverse">
                <div class="md:w-1/2 bg-[#9CA18F] p-12 text-white">
                    <h2 class="text-3xl font-bold mb-6">מוכנים לצעד הבא?</h2>
                    <p class="mb-8 opacity-90">השאירו פרטים ונחזור אליכם לשיחת ייעוץ ראשונית.</p>
                    <div class="space-y-4">
                        <p class="flex items-center gap-3 justify-start"><i class="fas fa-map-marker-alt"></i> ישראל</p>
                        <p class="flex items-center gap-3 justify-start"><i class="fas fa-envelope"></i> pninakar@gmail.com</p>
                        <p class="flex items-center gap-3 justify-start"><i class="fas fa-phone"></i> 054-8383451</p>
                    </div>
                </div>
                <div class="md:w-1/2 p-12">
                    <form id="combinedForm" class="space-y-4">
                        <div>
                            <label class="block text-sm font-bold mb-1">שם מלא</label>
                            <input type="text" name="name" id="userName" placeholder="איך קוראים לך?" class="border border-gray-200 rounded-lg p-3 w-full" required>
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-1">אימייל / טלפון</label>
                            <input type="text" name="contact" id="userContact" placeholder="איך נחזור אליך?" class="border border-gray-200 rounded-lg p-3 w-full" required>
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-1">מה מעניין אותך?</label>
                            <textarea name="message" id="userMessage" rows="3" placeholder="ספרו לנו קצת..." class="border border-gray-200 rounded-lg p-3 w-full"></textarea>
                        </div>
                        <button type="submit" id="submitBtn" class="btn-primary w-full py-4 rounded-xl font-bold text-lg">שליחת פנייה</button>
                        <p id="formStatus" class="text-center text-xs mt-2 text-gray-500 hidden italic">שולח נתונים ומעביר לוואטסאפ...</p>
                    </form>
                </div>
            </div>
